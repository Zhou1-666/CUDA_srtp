+    !===================================================================
+    ! pascal_a2av_profiled
+    ! --------------------
+    ! Diagnostic-only counterpart of pascal_a2av. The host-staging path
+    ! records allocation, copies, MPI, and release separately. Production
+    ! calls remain on pascal_a2av and incur no timing branches.
+    !===================================================================
+    subroutine pascal_a2av_profiled(A,Asize,sendcount,senddisp, B,Bsize,recvcount,recvdisp, &
+                                    nprocs,communicator,timing)
+        use mpi
+        use cudafor
+        implicit none
+        integer :: Asize,Bsize,nprocs,communicator
+        real*8, dimension(:), device :: A(0:Asize-1),B(0:Bsize-1)
+        integer, dimension(:) :: sendcount(0:nprocs-1),senddisp(0:nprocs-1)
+        integer, dimension(:) :: recvcount(0:nprocs-1),recvdisp(0:nprocs-1)
+        type(ptdma_timing_cuda), intent(inout) :: timing
+
+        integer :: ierr,alloc_status
+        real*8, allocatable :: hA(:), hB(:)
+        real(8) :: t_stage
+
+        ierr = CudaDeviceSynchronize()
+        call pascal_check_cuda(ierr,communicator,'pascal_a2av_profiled pre-MPI synchronization')
+
+        if(pascal_cuda_aware_mpi) then
+            call MPI_ALLTOALLV(A,sendcount,senddisp,MPI_DOUBLE, B,recvcount,recvdisp,MPI_DOUBLE, communicator, ierr)
+        else
+            t_stage = MPI_WTIME()
+            allocate(hA(0:Asize-1), hB(0:Bsize-1),stat=alloc_status)
+            call pascal_check_allocation(alloc_status,communicator,'pascal_a2av_profiled host staging')
+            timing%host_staging_allocate = timing%host_staging_allocate + MPI_WTIME() - t_stage
+
+            t_stage = MPI_WTIME()
+            hA = A
+            timing%host_staging_d2h = timing%host_staging_d2h + MPI_WTIME() - t_stage
+
+            t_stage = MPI_WTIME()
+            call MPI_ALLTOALLV(hA,sendcount,senddisp,MPI_DOUBLE, hB,recvcount,recvdisp,MPI_DOUBLE, communicator, ierr)
+            timing%host_staging_mpi = timing%host_staging_mpi + MPI_WTIME() - t_stage
+
+            if (ierr == MPI_SUCCESS) then
+                t_stage = MPI_WTIME()
+                B = hB
+                timing%host_staging_h2d = timing%host_staging_h2d + MPI_WTIME() - t_stage
+            endif
+
+            t_stage = MPI_WTIME()
+            deallocate(hA,hB)
+            timing%host_staging_free = timing%host_staging_free + MPI_WTIME() - t_stage
+        endif
+
+        call pascal_check_mpi(ierr,communicator,'MPI_ALLTOALLV in pascal_a2av_profiled')
+    end subroutine pascal_a2av_profiled
+
 end module PaScaL_TDMA_cuda_penta
